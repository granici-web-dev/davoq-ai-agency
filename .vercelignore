# Что не должно уезжать к хостеру.
#
# По умолчанию Vercel забирает весь монорепозиторий, а собирается из него
# один сайт. Всё остальное — это лишние файлы в чужой инфраструктуре, и
# среди них есть такие, которым там делать нечего вовсе.

# Клиентские документы. В сборке сайта не участвуют ни одним байтом.
apps/engine/*.pdf
apps/engine/*.docx
apps/engine/*.odt

# Локальные секреты. .gitignore их уже держит, но у .vercelignore своя
# область действия, и полагаться на второй список нельзя.
**/.env
**/.env.local
**/.env.prod

# Конфигурации клиентов: имена, домены, прайсы.
clients/
