/**
 * Потолки одновременных диалогов и месячной квоты.
 *
 * Модуль решает две вещи сразу: сколько диалогов клиента идёт прямо сейчас
 * и не перепрыгнет ли месячный потолок из-за того, что все они читают его
 * до того, как хоть один записался. Проверять это базой не нужно и незачем —
 * вся суть в арифметике.
 *
 *   npm run test:concurrency
 */
import { acquireSlot, inFlightFor, quotaExhausted, slotStats } from '../src/engine/api/concurrency.js';

let failures = 0;
const ok = (m: string): void => console.log(`  ✓ ${m}`);
const bad = (m: string): void => { console.error(`  ✗ ${m}`); failures++; };
const eq = (got: unknown, want: unknown, m: string): void =>
  got === want ? ok(m) : bad(`${m}: получено ${String(got)}, ожидалось ${String(want)}`);

const A = 'tenant-a';
const B = 'tenant-b';

// ── Потолок одновременных ───────────────────────────────────────────────────

// Потолок на клиента бережёт клиентов друг от друга: без него один арендатор
// занимает весь запас, и остальные получают отказ за чужую вину.
{
  const mine = [];
  for (let i = 0; i < 12; i++) mine.push(acquireSlot(A));
  eq(mine.every((s) => s !== null), true, 'двенадцать мест клиенту выдаются');
  eq(acquireSlot(A), null, 'тринадцатое — отказ');
  const other = acquireSlot(B);
  eq(other !== null, true, 'другой клиент не наказан за первого');
  other?.release();
  eq(inFlightFor(A), 12, 'счётчик в работе считает верно');
  for (const s of mine) s?.release();
  eq(inFlightFor(A), 0, 'после освобождения ноль');
}

// Двойной release увёл бы счётчик в минус и тихо снял потолок — то есть
// ошибка в обработке ошибки отключала бы защиту целиком.
{
  const s = acquireSlot(A)!;
  s.release();
  s.release();
  s.release();
  eq(inFlightFor(A), 0, 'двойное освобождение не уводит счётчик клиента в минус');
  // Общий счётчик важнее: клиентский при лишнем release просто удаляется
  // из карты и читается как ноль, а общий уходит в минус и тихо снимает
  // потолок на весь процесс.
  eq(slotStats().total, 0, 'и общий счётчик тоже');
  const again = [];
  for (let i = 0; i < 12; i++) again.push(acquireSlot(A));
  eq(again.every((x) => x !== null), true, 'потолок на месте после двойного освобождения');
  eq(acquireSlot(A), null, 'и тринадцатое по-прежнему отказ');
  for (const x of again) x?.release();
}

// Клиент, отпустивший всё, не должен оставаться в карте: иначе она растёт
// по числу когда-либо заходивших.
{
  const s = acquireSlot(B)!;
  s.release();
  eq(slotStats().tenants, 0, 'клиент без диалогов из карты убирается');
}

// ── Месячная квота ──────────────────────────────────────────────────────────

// Ради чего всё: между чтением потолка и записью проходят секунды работы
// модели. Без учёта тех, кто в работе, потолок перепрыгивается ровно
// на число одновременных.
eq(quotaExhausted(499, 500, 1), false, 'последнее сообщение до потолка проходит');
eq(quotaExhausted(500, 500, 1), true, 'на потолке — отказ');
eq(quotaExhausted(499, 500, 12), true, 'при одиннадцати в работе последнее место уже занято');
// Граница: дойти до потолка можно, перейти — нет. При 489 записанных и
// двенадцати в работе итог был бы 501, поэтому текущий уже не пропускается;
// при 488 итог ровно 500 — это потолок, а не превышение.
eq(quotaExhausted(489, 500, 12), true, 'потолок не перепрыгивается на число одновременных');
eq(quotaExhausted(488, 500, 12), false, 'но и не отнимает больше, чем в работе');
eq(quotaExhausted(0, 500, 1), false, 'пустой месяц пропускает');
eq(quotaExhausted(0, 0, 1), true, 'нулевой потолок не пропускает ничего');
// Текущий запрос свой слот уже занял — вычитать его обязательно, иначе
// клиент с потолком в одно сообщение не отправил бы ни одного.
eq(quotaExhausted(0, 1, 1), false, 'свой собственный слот в чужие не записывается');

console.log(failures === 0 ? '\nПОТОЛКИ OK' : `\nПОТОЛКИ НАРУШЕНЫ: ${failures}`);
process.exit(failures === 0 ? 0 : 1);
