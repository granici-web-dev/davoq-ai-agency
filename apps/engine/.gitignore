node_modules/
dist/
.env
.idea/

# Ключ сервисного аккаунта Google — приватный ключ, в репозиторий не попадает
secrets/
*service-account*.json

# Загруженные файлы клиентов — данные, не код
var/

# Скриншоты рабочих прогонов
*.png

# Окружение боевой установки — живёт только на сервере
.env.prod

# Резервные копии
backups/

# Артефакты прогонов Playwright — снимки и логи, а не исходники.
.playwright-mcp/

# ── Скиллы и настройки ИИ-агентов ────────────────────────────────────────
#
# Сами скиллы в репозиторий не идут: их 364 файла, они чужие, и обновлять
# их пришлось бы руками вместо `npx skills update`. Состав фиксирует
# `skills-lock.json` — он отслеживается, и восстанавливается всё из него:
#
#   npx skills experimental_install
#
# Кроме `impeccable`: его ставит собственный установщик, и в lock он не
# попадает. После восстановления нужен ещё `npx impeccable install`.
#
# Хуки и разрешения каждый ставит себе сам. Хук здесь — это команда,
# выполняемая на каждой правке файла; общий на репозиторий, он запускался бы
# у всех, включая тех, кто его себе не ставил.
.claude/settings.local.json
.claude/skills/
.agents/
.codex/
