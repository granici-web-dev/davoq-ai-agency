# Окружение боевой установки. Скопировать в .env.prod на сервере и заполнить.
#
#   cp .env.prod.example .env.prod && nano .env.prod
#
# Файл .env.prod в репозиторий не попадает (.gitignore) и в образ тоже
# (.dockerignore). Он живёт только на сервере.

# ── Домен ───────────────────────────────────────────────────────────────────
# A-запись этого имени должна указывать на сервер ДО первого запуска: Caddy
# запрашивает сертификат сразу, а у Let's Encrypt недельные лимиты на неудачи.
API_DOMAIN=bot.example.ro
PUBLIC_BASE_URL=https://bot.example.ro

# ── База ────────────────────────────────────────────────────────────────────
# Владелец базы. Под ним идут миграции и заведение клиентов — и только они.
POSTGRES_DB=assistwidget
POSTGRES_USER=assistwidget_owner
POSTGRES_PASSWORD=

# Приложение ходит ДРУГОЙ ролью — assistwidget_app, без права обходить RLS.
# Владелец базы superuser и обходит даже FORCE RLS: под ним изоляция клиентов
# существует только на бумаге. Пароль этой роли задаётся из APP_DB_PASSWORD
# при миграции — в самой миграции он 'dev', и на сервере таким остаться не должен.
APP_DB_PASSWORD=

# Обе строки указывают на службу db внутри сети docker, порта наружу у неё нет.
DATABASE_URL=postgres://assistwidget_app:ЗДЕСЬ_APP_DB_PASSWORD@db:5432/assistwidget
DATABASE_ADMIN_URL=postgres://assistwidget_owner:ЗДЕСЬ_POSTGRES_PASSWORD@db:5432/assistwidget

REDIS_URL=redis://redis:6379

# ── Модель ──────────────────────────────────────────────────────────────────
# Права выданы политикой infra/bedrock-policy.json — примените её в консоли AWS.
AWS_REGION=eu-central-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Модель тарифов Start и Pro.
MODEL_BASE=eu.anthropic.claude-haiku-4-5-20251001-v1:0
# Модель тарифа Business. Втрое дороже входа и выхода — это и есть то,
# что оплачивает разницу в цене тарифа. Одинаковые значения здесь означают,
# что разницы между тарифами нет никакой.
MODEL_PREMIUM=eu.anthropic.claude-sonnet-4-5-20250929-v1:0
EMBEDDING_MODEL=amazon.titan-embed-text-v2:0

# ── Секреты ─────────────────────────────────────────────────────────────────
# Ключ шифрования токенов Google Drive и коннекторов.
#
#   openssl rand -hex 32
#
# МЕНЯТЬ НЕЛЬЗЯ НИКОГДА. Со сменой ключа всё зашифрованное станет нечитаемым,
# и восстановить его будет неоткуда — в резервную копию ключ не попадает
# намеренно. Запишите его туда же, где остальные пароли установки.
SECRETS_KEY=

# ── Почта ───────────────────────────────────────────────────────────────────
# Без SMTP_URL заявка не уедет в отдел продаж, и узнаете вы об этом из тишины.
# Отправитель обязан быть на домене клиента, со SPF и DKIM, иначе спам.
SMTP_URL=smtps://user:password@smtp.example.com:465
MAIL_FROM=SofaBelle Asistent <asistent@sofabelle.ro>

# ── Оплата ──────────────────────────────────────────────────────────────────
# ВНИМАНИЕ: Stripe не открывает счета молдавским компаниям — проверьте
# stripe.com/global до того, как заводить аккаунт. Если нельзя, менять придётся
# src/platform/billing/stripe.ts, а не остальной портал: граница проведена там.
# Продавцы записи (Paddle, Lemon Squeezy) принимают продавцов из большего числа
# стран и берут на себя НДС, но комиссия выше и выплаты медленнее.
STRIPE_SECRET_KEY=
# Ключ подписи вебхука. Без него вебхуки отвергаются — и это правильно:
# без проверки подписи любой желающий ставит себе «оплачено» одним curl.
STRIPE_WEBHOOK_SECRET=
# Идентификаторы цен из панели Stripe. Заводятся там, сюда попадают строкой.
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=

# Пробный период и отсрочка после неудачного платежа, в днях.
TRIAL_DAYS=14
BILLING_GRACE_DAYS=7

# ── Наблюдение ──────────────────────────────────────────────────────────────
# Наблюдатель раз в минуту спрашивает у API, всё ли в порядке, и пишет письмо,
# когда перестаёт быть в порядке.
#
# Токен закрывает /health/ready: наружу состояние базы, очередей и диска
# отдавать незачем. Прокси её тоже не пропускает — это второй замок.
#   openssl rand -hex 16
OPS_TOKEN=

# Куда писать о поломке. НАШ адрес, не клиента: клиенту незачем знать, что
# у нас кончилось место на диске.
WATCHDOG_EMAIL=

# «Мёртвая рука» — и это обязательный пункт, а не украшение.
#
# Наблюдатель живёт на том же сервере и умрёт вместе с ним: письма о смерти
# машины не будет НИ ОТ КОГО. Поэтому пока всё хорошо, он дёргает внешний
# адрес, а внешняя служба поднимает тревогу, когда сигналы ПЕРЕСТАЮТ приходить.
# Молчание становится сигналом.
#
# Годится любая бесплатная служба (healthchecks.io, Better Stack, cron-job.org)
# или cron на другой машине. На этом же сервере — бессмысленно.
HEARTBEAT_URL=

# Как подписывать письма. По умолчанию — API_DOMAIN.
WATCHDOG_LABEL=

# Тревога поднимается после стольких неудач подряд, а не после первой:
# письмо на каждую сетевую заминку учит человека не читать эти письма.
WATCHDOG_FAILURES=3
WATCHDOG_INTERVAL_MS=60000
WATCHDOG_REMINDER_MS=21600000

# Пороги проверок
DISK_FREE_MIN_PCT=10
QUEUE_BACKLOG_MAX=100
WORKER_SILENCE_MS=180000

# ── Потолки ─────────────────────────────────────────────────────────────────
# Умолчания рассчитаны на пилот. Менять по замеру, а не на всякий случай.
#
# Замер (npm run test:load, результаты в deploy/README.md) показал: до 12
# одновременных диалогов всё обслуживается без единой ошибки, а выше упирается
# не этот потолок, а квота Bedrock. Поэтому поднимать числа ниже бессмысленно,
# пока не поднята квота в Service Quotas у Amazon.
CHAT_MAX_CONCURRENT=32
CHAT_MAX_PER_TENANT=12
DB_POOL_MAX=20
DB_CONNECT_TIMEOUT_MS=5000
DB_STATEMENT_TIMEOUT_MS=15000
LANGUAGE_PROBE_CHARS=90

# Хранилище файлов внутри контейнера. Каталог смонтирован томом docker;
# менять значение без изменения тома нельзя — файлы окажутся вне копии.
STORAGE_DIR=/app/var/uploads

# Резервные копии
BACKUP_KEEP_DAYS=14
