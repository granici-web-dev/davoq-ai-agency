{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "InvokeViaEuInferenceProfile",
      "Effect": "Allow",
      "Action": [
        "bedrock:InvokeModel",
        "bedrock:InvokeModelWithResponseStream"
      ],
      "Resource": [
        "arn:aws:bedrock:eu-*::foundation-model/*",
        "arn:aws:bedrock:eu-central-1:093487859892:inference-profile/eu.*"
      ]
    },
    {
      "Sid": "MantleInference",
      "Effect": "Allow",
      "Action": "bedrock-mantle:CreateInference",
      "Resource": "arn:aws:bedrock-mantle:eu-central-1:093487859892:project/*"
    },
    {
      "Sid": "ListForDiagnostics",
      "Effect": "Allow",
      "Action": [
        "bedrock:ListFoundationModels",
        "bedrock:GetFoundationModel",
        "bedrock:ListInferenceProfiles",
        "bedrock:GetInferenceProfile"
      ],
      "Resource": "*"
    },
    {
      "Sid": "MarketplaceSubscribeTemporary",
      "Effect": "Allow",
      "Action": [
        "aws-marketplace:ViewSubscriptions",
        "aws-marketplace:Subscribe"
      ],
      "Resource": "*"
    }
  ]
}
