# Postgres (docker-compose пробрасывает 5433, чтобы не конфликтовать с локальным)
# Рабочая роль приложения: NOSUPERUSER, NOBYPASSRLS. На ней держится изоляция
# клиентов — владелец базы обходит даже FORCE ROW LEVEL SECURITY.
DATABASE_URL=postgres://app:dev@localhost:5433/assistwidget
REDIS_URL=redis://localhost:6380

# Claude через Amazon Bedrock, регион ЕС — см. 06-Implement/stack.md.
# Первичный Anthropic API не даёт EU-residency: inference_geo принимает только us и global.
AWS_REGION=eu-central-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Это inference profile (префикс eu.), а не foundation model: по прямому id
# новые модели Anthropic на Bedrock не вызываются.
MODEL_BASE=eu.anthropic.claude-haiku-4-5-20251001-v1:0
# Модель тарифа Business. Идентификатор проверен живым вызовом: прежнее
# значение `eu.anthropic.claude-sonnet-5` в Bedrock не существует и отвечало 403.
MODEL_PREMIUM=eu.anthropic.claude-sonnet-4-5-20250929-v1:0

# 1024 измерения — под vector(1024) в схеме. Пишется в chunks.embedding_model.
# Titan — модель самой AWS, работает без подписки Marketplace.
# Cohere embed-multilingual-v3 сильнее на неанглийских языках, но требует
# разового вызова администратором с правом aws-marketplace:Subscribe.
EMBEDDING_MODEL=amazon.titan-embed-text-v2:0

# Ключ шифрования секретов коннекторов, 32 байта в base64.
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SECRETS_KEY=
STORAGE_DIR=var/uploads

# Владелец базы: только миграции и заведение тенантов.
# В конфигурацию веб-процесса этот адрес попадать не должен.
DATABASE_ADMIN_URL=postgres://app:dev@localhost:5433/assistwidget

# ── Почта и адрес наружу ───────────────────────────────────────────────────
# Локально письма ловит Mailpit (docker compose), наружу ничего не уходит.
# В работе нужны все три: без SMTP_URL заявка не уедет в отдел продаж,
# без PUBLIC_BASE_URL ссылка в письме ведёт на localhost, то есть в никуда.
#
# MAIL_FROM должен быть на домене клиента и с настроенными SPF и DKIM —
# иначе письмо о заявке уходит в спам, и клиент узнаёт об этом не от нас.
SMTP_URL=smtp://localhost:1025
MAIL_FROM=AssistWidget <no-reply@assistwidget.local>
PUBLIC_BASE_URL=http://localhost:3779

# ── Потолки ────────────────────────────────────────────────────────────────
# Всё, что может расходоваться без спроса, имеет потолок. Значения ниже —
# умолчания, рассчитанные на пилот; менять их имеет смысл по замеру, а не
# «на всякий случай».
#
# Потолок на клиента важнее общего: без него один арендатор занимает весь
# запас, и остальные получают отказ за чужую вину.
CHAT_MAX_CONCURRENT=32
CHAT_MAX_PER_TENANT=12

# Частота на пару «клиент + адрес». Считаем по адресу, а не по посетителю:
# его идентификатор приходит из тела запроса, и скрипту не стоит ничего
# слать каждый раз новый. Публичный ключ лежит в HTML сайта клиента, Origin
# подделывается обычным curl — без этих потолков между чужим скриптом и
# счётом клиента не стоит ничего.
#
# Живой посетитель до них не дотягивается: он читает ответ и печатает,
# то есть шлёт три-шесть сообщений в минуту. А вот НАШИ наборы дотягиваются —
# контрольный шлёт пятнадцать вопросов подряд. Против него поднимайте:
#   CHAT_RATE_PER_MINUTE=60 CHAT_RATE_PER_HOUR=600
CHAT_RATE_PER_MINUTE=10
CHAT_RATE_PER_HOUR=60
DB_POOL_MAX=20
DB_CONNECT_TIMEOUT_MS=5000
DB_STATEMENT_TIMEOUT_MS=15000

# Сколько знаков ответа придерживается охрана языка, прежде чем судить.
# Задержка платится всеми и всегда, поэтому порог маленький намеренно.
LANGUAGE_PROBE_CHARS=90

# Портал клиента (кабинет всех агентов). Нужен для возврата из Stripe:
# оплата, начатая в портале, обязана и заканчиваться в портале.
# Пусто — возврат идёт в панель движка, как раньше.
PORTAL_BASE_URL=http://localhost:3001

# ── Поагентная оплата ──────────────────────────────────────────────────────
# Цена каждой вилки каждого агента — отдельной ценой в Stripe. Год тоже
# отдельной: Stripe считает периоды по цене, скидкой к месячной это не
# выражается. Имя собирается из идентификаторов:
#   STRIPE_PRICE_AGENT_<АГЕНТ>_<ВИЛКА>[_YEARLY]
# Дефисы в идентификаторе агента заменяются подчёркиваниями.
#
# STRIPE_PRICE_AGENT_CHATBOT_BASIC=price_...
# STRIPE_PRICE_AGENT_CHATBOT_PRO=price_...
# STRIPE_PRICE_AGENT_CHATBOT_BASIC_YEARLY=price_...
# STRIPE_PRICE_AGENT_CONFIGURATOR_BASIC=price_...
#
# Скидка за количество — купоном, а не ценой: она зависит от того, сколько
# агентов клиент берёт, и вшивать её в цену значило бы завести отдельную цену
# на каждое сочетание.
# STRIPE_COUPON_VOLUME_10=...
# STRIPE_COUPON_VOLUME_20=...
#
# Пока цен и купонов нет, заказ принимается письмом на SALES_EMAIL — с тем же
# расчётом, который видел клиент.
SALES_EMAIL=
