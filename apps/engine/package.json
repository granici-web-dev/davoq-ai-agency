{
  "name": "assistwidget",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/engine/api/server.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "migrate": "tsx src/engine/db/migrate.ts",
    "db:up": "docker compose up -d && sleep 3 && npm run migrate",
    "build:widget": "esbuild src/engine/widget/embed.tsx --bundle --minify --format=iife --target=es2020 --outfile=dist/widget.js",
    "build:admin": "esbuild src/engine/admin/main.tsx --bundle --minify --format=iife --target=es2020 --outfile=dist/admin.js",
    "worker": "tsx src/engine/ingest/worker.ts",
    "smoke": "node scripts/smoke.mjs",
    "cli": "tsx --env-file=.env src/platform/cli/admin.ts",
    "client": "tsx --env-file=.env src/platform/cli/client.ts",
    "test:isolation": "tsx --env-file=.env scripts/isolation-test.mts",
    "test:control": "tsx --env-file=.env scripts/control-set.mts",
    "test:guard": "tsx --env-file=.env scripts/prompt-guard-test.mts",
    "test:language": "tsx scripts/language-test.mts",
    "test:ssrf": "tsx scripts/ssrf-test.mts"
  },
  "dependencies": {
    "@anthropic-ai/bedrock-sdk": "^0.30.0",
    "@aws-sdk/client-bedrock-runtime": "^3.700.0",
    "@fastify/multipart": "^10.1.1",
    "@types/nodemailer": "^8.0.1",
    "bullmq": "^5.0.0",
    "cheerio": "^1.2.0",
    "fastify": "^5.0.0",
    "geist": "^1.7.2",
    "ioredis": "^5.4.0",
    "jszip": "^3.10.1",
    "mammoth": "^1.12.1",
    "nodemailer": "^9.0.5",
    "pg": "^8.13.0",
    "preact": "^10.29.8",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "undici": "^7.29.0",
    "unpdf": "^1.8.1",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "esbuild": "^0.28.2",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
