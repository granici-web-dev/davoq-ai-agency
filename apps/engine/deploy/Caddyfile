# Сертификат Caddy берёт и продлевает сам — от нас нужен только домен,
# у которого A-запись указывает на этот сервер.

{$API_DOMAIN} {
	encode zstd gzip

	# Панель — по логину, но её адрес незачем отдавать поисковикам.
	header /admin* X-Robots-Tag "noindex, nofollow"

	# Заголовки безопасности ставятся здесь, а не в приложении: они одинаковы
	# для всех ответов, включая статику и ошибки самого прокси.
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		# Виджет встраивается в страницу клиента, но САМ наш сервер во фрейме
		# показываться не должен: панель во фрейме на чужом сайте — это кликджекинг.
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	reverse_proxy api:3000 {
		# Ответ бота — поток: он идёт кусками несколько секунд. Буферизация
		# прокси собрала бы его целиком и отдала разом, и посетитель вместо
		# печатающегося ответа видел бы паузу, а потом стену текста.
		flush_interval -1

		# Тайм-аут больше самого долгого ответа с запасом: до четырёх обращений
		# к модели плюс вызовы коннекторов.
		transport http {
			response_header_timeout 120s
		}
	}

	log {
		output file /data/access.log {
			roll_size 20MiB
			roll_keep 7
		}
		# Тело запроса содержит вопрос посетителя, тело ответа — ответ бота.
		# В журнал прокси им не место: переписка хранится в базе, где она
		# под RLS и удаляется по сроку хранения.
		format json
	}
}
